# Em desenvolvimento, `npm run dev` sobe um PostgreSQL local e ignora esta linha.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/intelite?schema=public"
# Segredo dos cookies de sessão (mínimo 32 caracteres). Gere com: openssl rand -hex 32
SESSION_SECRET="troque-este-valor-por-um-segredo-longo-e-aleatorio"
# Onde guardar as fotos: "local" (pasta ./storage, desenvolvimento) ou "db" (no PostgreSQL; recomendado no Render).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
# Administrador criado pelo seed (só na primeira vez)
ADMIN_EMAIL="admin@intelite.local"
ADMIN_PASSWORD="trocar-esta-senha-123"
# Em rede interna acessada por HTTP (sem HTTPS), use false; com HTTPS, deixe em branco.
# COOKIE_SECURE="false"
