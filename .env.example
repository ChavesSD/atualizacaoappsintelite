# Conexão PostgreSQL (use `npm run db:local` para um Postgres embutido em desenvolvimento)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/intelite?schema=public"
# Segredo para assinar cookies de sessão (mín. 32 caracteres). Gere com: openssl rand -hex 32
SESSION_SECRET="troque-este-valor-por-um-segredo-longo-e-aleatorio"
# Armazenamento das fotos: "local" (dev) ou "s3" (produção, ver docs)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
