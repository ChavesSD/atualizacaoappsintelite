// Central de Atualização do Atendimento Inteligente — modelo simples.
// Um "Envio" = um cliente passando pelo tutorial. Tudo que o cliente declara fica separado do que a equipe confirma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Format {
  TEXTO
  VIDEO
}

enum Framing {
  NAO_VERIFICADO
  CORRETO
  INCORRETO
  PRECISA_SUPORTE
}

enum SubmissionStatus {
  EM_ANDAMENTO
  ENVIADO
  APROVADO
  PRECISA_AJUSTE
}

enum PhotoType {
  /// Foto da tela do equipamento (totem ou painel: o aplicativo é o mesmo). TOTEM/PAINEL só existem em envios antigos.
  TELA
  TOTEM
  PAINEL
}

enum PhotoReview {
  PENDENTE
  APROVADA
  REFAZER
}

model Submission {
  id          String           @id @default(cuid())
  company     String
  contactName String
  status      SubmissionStatus @default(EM_ANDAMENTO)
  /// Etapa atual (índice em STEPS). Salva a cada avanço: o cliente retoma de onde parou.
  step        Int              @default(0)

  /// Formato inicial escolhido e formato em uso; `formatChanges` conta as trocas (cliente nunca duplica).
  initialFormat Format?
  format        Format?
  formatChanges Int     @default(0)

  /// Solução escolhida na abertura da página (hoje só existe o Atendimento Inteligente).
  solution String @default("atendimento-inteligente")

  // Um só aplicativo (híbrido) atende totem e painel, então há um só fluxo. As colunas mantêm os nomes antigos do banco
  // (@map) para não exigir migração; os campos painel* abaixo só existem em envios feitos antes da unificação.
  installed Boolean @default(false) @map("totemUpdated")

  // Autodeclaração do cliente
  framing       Framing  @default(NAO_VERIFICADO) @map("totemFraming")
  framingIssues String[] @map("totemIssues")
  framingNotes  String?  @map("totemNotes")

  // Confirmação da equipe (campo separado da autodeclaração)
  confirmed Boolean @default(false) @map("totemConfirmed")

  // legado (envios anteriores à unificação; não usados pelo fluxo atual)
  painelUpdated   Boolean  @default(false)
  painelFraming   Framing  @default(NAO_VERIFICADO)
  painelIssues    String[]
  painelNotes     String?
  painelConfirmed Boolean  @default(false)

  helpRequested Boolean @default(false)
  helpResolved  Boolean @default(false)
  helpMessage   String?
  helpStep      String?
  helpFormat    Format?

  rating      Int?
  comment     String?
  hardestStep String?
  adminNotes  String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  submittedAt DateTime?

  photos     Photo[]
  activities Activity[]

  @@index([status])
  @@index([createdAt])
}

model Photo {
  id           String      @id @default(cuid())
  submissionId String
  type         PhotoType
  storageKey   String      @unique
  mime         String
  sizeBytes    Int
  review       PhotoReview @default(PENDENTE)
  reviewNote   String?
  createdAt    DateTime    @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

/// Linha do tempo do envio: o que o cliente fez e o que a equipe decidiu.
model Activity {
  id           String   @id @default(cuid())
  submissionId String
  actor        String // CLIENTE | EQUIPE
  text         String
  at           DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, at])
}

/// Conteúdo editável de cada etapa do tutorial.
model Step {
  id           String   @id @default(cuid())
  key          String   @unique
  position     Int
  title        String
  /// Um passo por linha.
  instructions String
  warning      String?
  imagePath    String?
  videoUrl     String?
  videoTitle   String?
  active       Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

model Setting {
  key   String @id
  value String
}

model AdminUser {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String
  active       Boolean @default(true)
}

/// Arquivos (fotos e imagens do tutorial) guardados no banco quando STORAGE_DRIVER=db.
/// Em hospedagens com disco efêmero (ex.: Render sem disco persistente) isso evita perder fotos a cada deploy.
model FileBlob {
  key       String   @id
  data      Bytes
  createdAt DateTime @default(now())
}
